# Copy this file to .env and fill in real values.
# Never commit .env
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
REPORTS_TABLE=compliance-reports
VIOLATIONS_TABLE=compliance-violations
DOCS_BUCKET=regulatory-compliance-123456789012
ESCALATION_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:compliance-escalations-sns
REVIEW_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:compliance-review-sns
DOCUMENT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/compliance-docs
ENVIRONMENT=development
LOG_LEVEL=INFO
